# Resend API Key for sending contact form emails
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email address to receive contact form submissions
RECIPIENT_EMAIL=your-email@example.com

# GA4 measurement ID (e.g. G-XXXXXXX). Loaded by app/layout.tsx via @next/third-parties.
# Leave unset to disable GA in dev/preview builds.
NEXT_PUBLIC_GA_ID=

# IndexNow key — must match the filename in /public/<key>.txt
# Used by scripts/indexnow-ping.mjs to notify Bing/Yandex of new/updated URLs.
INDEXNOW_KEY=d90242329a4a4f3db82d67bdb02afc14
